<?xml version="1.0" encoding="UTF-8"?>

<AMPSConfig>
    <Name>AMPS-Kafka-Tests</Name>
    <Group>KafkaConnectorTests</Group>

    <Transports>
        <Transport>
            <Name>any-tcp</Name>
            <Type>tcp</Type>
            <InetAddr>9007</InetAddr>
            <Protocol>amps</Protocol>
            <ReuseAddr>true</ReuseAddr>
        </Transport>
        <Transport>
            <Name>any-ws</Name>
            <Type>tcp</Type>
            <InetAddr>9008</InetAddr>
            <Protocol>websocket</Protocol>
            <ReuseAddr>true</ReuseAddr>
        </Transport>
        <Transport>
            <Name>failover-tcp</Name>
            <Type>tcp</Type>
            <InetAddr>9011</InetAddr>
            <Protocol>amps</Protocol>
            <ReuseAddr>true</ReuseAddr>
        </Transport>
        <Transport>
            <Name>amps-replication</Name>
            <Type>amps-replication</Type>
            <InetAddr>10004</InetAddr>
            <ReuseAddr>true</ReuseAddr>
        </Transport>
    </Transports>

    <Replication>
        <Destination>
            <Topic>
                <Name>SourceTest</Name>
                <MessageType>json</MessageType>
            </Topic>
            <Topic>
                <Name>SinkTestFailover.*</Name>
                <MessageType>json</MessageType>
            </Topic>
            <Name>AMPS-Kafka-Tests-Replica</Name>
            <PassThrough>.*</PassThrough>
            <Group>KafkaConnectorTests</Group>
            <SyncType>sync</SyncType>
            <Transport>
                <InetAddr>10005</InetAddr>
                <Type>amps-replication</Type>
            </Transport>
        </Destination>
    </Replication>

    <Admin>
        <InetAddr>8085</InetAddr>
        <SQLTransport>any-ws</SQLTransport>
        <FileName>./amps-files/kafka-connector-tests/stats.db</FileName>
        <Interval>1s</Interval>
    </Admin>

    <Logging>
        <Target>
            <Protocol>stdout</Protocol>
            <Level>warning</Level>
            <IncludeErrors>00-0015</IncludeErrors>
        </Target>
        <Target>
            <Protocol>file</Protocol>
            <FileName>./amps-files/kafka-connector-tests/logs/kafka_connector_tests.log</FileName>
            <RotationThreshold>10MB</RotationThreshold>
            <Level>info</Level>
        </Target>
    </Logging>

    <TransactionLog>
        <JournalDirectory>./amps-files/kafka-connector-tests/journals</JournalDirectory>
        <JournalSize>20MB</JournalSize>
        <Topic>
            <Name>.*</Name>
            <MessageType>json</MessageType>
        </Topic>
    </TransactionLog>

    <SOW>
        <Queue>
            <Name>QueueSourceTest</Name>
            <MessageType>json</MessageType>
            <Semantics>at-least-once</Semantics>
            <MaxBacklog>1000000</MaxBacklog>
            <MaxPerSubscriptionBacklog>1000000</MaxPerSubscriptionBacklog>
            <LeasePeriod>5s</LeasePeriod>
        </Queue>
        <Topic>
            <Name>Orders</Name>
            <MessageType>json</MessageType>
            <FileName>./amps-files/kafka-connector-tests/sow/%n-json.sow</FileName>
            <Key>/order_key</Key>
            <SlabSize>1MB</SlabSize>
        </Topic>
    </SOW>

    <Actions>
        <Action>
            <On>
                <Module>amps-action-on-publish-message</Module>
                <Options>
                    <Topic>enableKafkaFailoverTransport</Topic>
                    <MessageType>json</MessageType>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-enable-transport</Module>
                <Options>
                    <Transport>failover-tcp</Transport>
                </Options>
            </Do>
        </Action>
        <Action>
            <On>
                <Module>amps-action-on-publish-message</Module>
                <Options>
                    <Topic>disableKafkaFailoverTransport</Topic>
                    <MessageType>json</MessageType>
                </Options>
            </On>
            <Do>
                <Module>amps-action-do-disable-transport</Module>
                <Options>
                    <Transport>failover-tcp</Transport>
                </Options>
            </Do>
        </Action>
    </Actions>
</AMPSConfig>
